rules_version = '2';
// REGLAS DE SEGURIDAD (paso 4 de la guía)
// Solo los correos de la lista pueden leer y escribir datos.
// Cambie los correos de ejemplo por los suyos (los mismos que crea en Authentication).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'correo-del-taller@gmail.com',
          'segundo-equipo@gmail.com'
        ];
    }
  }
}
